# ==============================================================================
# TRADING ONLINE - CONFIGURATION SETTINGS
# ==============================================================================

# Mode: Set to True for simulated paper trading (NO REAL MONEY AT RISK)
# Set to False only when you are ready to place live orders on Zerodha
PAPER_TRADING=True
PAPER_INITIAL_CAPITAL=100000.0

# Zerodha Kite Connect Credentials
# Obtain from https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_USER_ID=your_zerodha_user_id
# Optional: Set access token manually if generated externally
KITE_ACCESS_TOKEN=

# Institutional Risk Management Parameters
MAX_DAILY_LOSS=1000.0            # Circuit breaker: Auto-halts trading if daily loss reaches this (₹)
MAX_LOTS=1                       # Fixed 1-lot sizing during validation phase
STOP_LOSS_PCT=0.01               # 1% stop loss on equity or 15% on options premium
TARGET_RR_RATIO=2.0              # Minimum 1:2 Risk to Reward
MANDATORY_SQUARE_OFF_TIME="15:15" # Auto square-off all intraday positions before market close (IST)

# Default Trading Instrument
DEFAULT_SYMBOL=NSE:NIFTY 50
TIMEFRAME=5minute
