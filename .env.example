# ==============================================================================
# TRADING ONLINE - CONFIGURATION SETTINGS
# ==============================================================================

# Mode: Set to True for simulated paper trading (NO REAL MONEY AT RISK)
# Set to False only when you are ready to place live orders on Zerodha
PAPER_TRADING=True
PAPER_INITIAL_CAPITAL=100000.0

# Zerodha Kite Connect Credentials
# Obtain from https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_USER_ID=your_zerodha_user_id
# Optional: Set access token manually if generated externally
KITE_ACCESS_TOKEN=

# Institutional Risk Management Parameters
MAX_DAILY_LOSS=1000.0            # Circuit breaker: Auto-halts trading if daily loss reaches this (₹)
MAX_LOTS=1                       # Fixed 1-lot sizing during validation phase
STOP_LOSS_PCT=0.01               # 1% stop loss on equity or 15% on options premium
TARGET_RR_RATIO=2.0              # Minimum 1:2 Risk to Reward
MANDATORY_SQUARE_OFF_TIME="15:15" # Auto square-off all intraday positions before market close (IST)

# Default Trading Instrument
DEFAULT_SYMBOL=NSE:NIFTY 50
TIMEFRAME=5minute

# ==============================================================================
# CRYPTOCURRENCY SETTINGS (Binance, Bybit, OKX, Kraken, etc.)
# ==============================================================================
# Supported exchanges: binance, bybit, okx, kraken, coindcx, delta
CRYPTO_EXCHANGE=binance
# Set to True for testnet/sandbox mode (free virtual funds provided by exchange)
CRYPTO_TESTNET=True
# Crypto API keys (Leave blank to use live public market data in Paper mode)
CRYPTO_API_KEY=
CRYPTO_API_SECRET=
CRYPTO_API_PASSWORD=
CRYPTO_DEFAULT_SYMBOL=BTC/USDT
CRYPTO_TIMEFRAME=5m
CRYPTO_PAPER_INITIAL_CAPITAL=10000.0  # Virtual USDT for simulation
CRYPTO_MAKER_FEE=0.0002              # 0.02% maker fee
CRYPTO_TAKER_FEE=0.0005              # 0.05% taker fee
CRYPTO_SLIPPAGE_PCT=0.0002           # 0.02% estimated execution drag

# ==============================================================================
# FOREX & CURRENCY DERIVATIVES (NSE CDS & Global Forex)
# ==============================================================================
FOREX_DEFAULT_SYMBOL=CDS:USDINR       # Default currency pair (CDS:USDINR, CDS:EURINR, EURUSD, etc.)
CDS_SQUARE_OFF_TIME="16:45"           # Mandatory square-off for NSE CDS (market closes 17:00 IST)
FOREX_ENABLE_MIDDAY_FILTER=False      # Disabled: London session opens at 13:30 IST driving currency momentum

# ==============================================================================
# TRADINGVIEW WEBHOOK ALERT INTEGRATION
# ==============================================================================
WEBHOOK_HOST=0.0.0.0                  # Webhook listener binding address
WEBHOOK_PORT=8000                     # Port to receive TradingView alert webhooks
WEBHOOK_SECRET=trading_online_secure_token  # Passphrase token sent in TradingView alert payload
