//@version=5
strategy("Trading Online - Institutional AI Confluence Strategy", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=75, commission_type=strategy.commission.cash_per_order, commission_value=20)

// ==============================================================================
// ⚡ TRADING ONLINE INSTITUTIONAL PINE SCRIPT V5
// SuperTrend (10,3) + Dual EMA (9,21) + RSI (14) + ADX (14) & Choppiness Filter
// Includes Midday No-Trade Window (11:30 - 13:30 IST) & Webhook Alert Payloads
// ==============================================================================

// --- 1. DUAL EXPONENTIAL MOVING AVERAGES ---
grp_ema = "1. Exponential Moving Averages"
emaFastLen = input.int(9, title="Fast EMA Length", group=grp_ema)
emaSlowLen = input.int(21, title="Slow EMA Length", group=grp_ema)
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

plot(emaFast, title="EMA 9 (Fast)", color=color.new(#00e5ff, 0), linewidth=2)
plot(emaSlow, title="EMA 21 (Slow)", color=color.new(#ff9100, 0), linewidth=2)

// --- 2. SUPERTREND TREND STRUCTURAL FILTER ---
grp_st = "2. SuperTrend Settings"
atrPeriod = input.int(10, title="ATR Period", group=grp_st)
atrMultiplier = input.float(3.0, title="ATR Multiplier", group=grp_st)
[supertrend, direction] = ta.supertrend(atrMultiplier, atrPeriod)
isBullishTrend = direction < 0

plot(supertrend, title="SuperTrend", color=isBullishTrend ? color.green : color.red, linewidth=2, style=plot.style_linebr)

// --- 3. RSI MOMENTUM OSCILLATOR ---
grp_rsi = "3. RSI Filter"
rsiLen = input.int(14, title="RSI Length", group=grp_rsi)
rsiVal = ta.rsi(close, rsiLen)
rsiBuyMin = input.float(52.0, "RSI Long Min Threshold", group=grp_rsi)
rsiBuyMax = input.float(72.0, "RSI Long Max (Overbought Guard)", group=grp_rsi)
rsiSellMax = input.float(48.0, "RSI Short Max Threshold", group=grp_rsi)
rsiSellMin = input.float(28.0, "RSI Short Min (Oversold Guard)", group=grp_rsi)

// --- 4. STATISTICAL REGIME GATES (ADX & CHOPPINESS INDEX) ---
grp_regime = "4. Regime & Anti-Chop Filters"
adxLen = input.int(14, title="ADX Length", group=grp_regime)
adxThreshold = input.float(22.0, title="ADX Trend Threshold (Min 22.0)", group=grp_regime)
[diplus, diminus, adxVal] = ta.dmi(adxLen, adxLen)

// Choppiness Index (CI)
chopLen = input.int(14, title="Choppiness Index Length", group=grp_regime)
chopThreshold = input.float(61.8, title="Chop Threshold (Block if >= 61.8)", group=grp_regime)
ci = 100 * math.log10(math.sum(ta.atr(1), chopLen) / (ta.highest(high, chopLen) - ta.lowest(low, chopLen))) / math.log10(chopLen)

// --- 5. MIDDAY WHIPSAW WINDOW FILTER (11:30 - 13:30 IST) ---
grp_session = "5. Time Windows & Session Filters"
enableMiddayFilter = input.bool(true, title="Block Midday False Liquidity (11:30 - 13:30 IST)", group=grp_session)
curHour = hour(time, "Asia/Kolkata")
curMinute = minute(time, "Asia/Kolkata")
timeMinutes = curHour * 60 + curMinute
isMiddayChop = enableMiddayFilter and (timeMinutes >= 11 * 60 + 30) and (timeMinutes <= 13 * 60 + 30)

// Highlight Midday Zone on Chart
bgcolor(isMiddayChop ? color.new(color.orange, 90) : na, title="Midday No-Trade Zone")

// Regime Gate Resolution
isRegimeTrending = (adxVal >= adxThreshold) and (ci < chopThreshold) and not isMiddayChop

// --- 6. TRIPLE CONFLUENCE SIGNAL CONDITIONS ---
longCondition = isBullishTrend and (emaFast > emaSlow) and (rsiVal >= rsiBuyMin) and (rsiVal <= rsiBuyMax) and isRegimeTrending
shortCondition = not isBullishTrend and (emaFast < emaSlow) and (rsiVal <= rsiSellMax) and (rsiVal >= rsiSellMin) and isRegimeTrending

// Visual Shapes for Signals
plotshape(longCondition and strategy.position_size == 0, title="BUY Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal, text="BUY")
plotshape(shortCondition and strategy.position_size == 0, title="SELL Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal, text="SELL")

// --- 7. ADAPTIVE RISK-REWARD & EXECUTION ---
grp_risk = "6. Risk Management & Exits"
riskMode = input.string("ATR Multiplier", title="Stop Loss Mode", options=["ATR Multiplier", "Fixed Points"], group=grp_risk)
atrSL = input.float(1.5, title="SL ATR Multiplier", group=grp_risk)
atrTgt = input.float(3.0, title="Target ATR Multiplier (1:2 R:R)", group=grp_risk)
fixedSL = input.float(25.0, title="Fixed SL Points (Nifty)", group=grp_risk)
fixedTgt = input.float(55.0, title="Fixed Target Points (Nifty)", group=grp_risk)

atrValue = ta.atr(14)
slDistance = riskMode == "ATR Multiplier" ? atrValue * atrSL : fixedSL
tgtDistance = riskMode == "ATR Multiplier" ? atrValue * atrTgt : fixedTgt

// --- 8. TRADINGVIEW WEBHOOK ALERT INTEGRATION ---
grp_webhook = "7. Webhook Alert Configuration"
webhookSecret = input.string("trading_online_secure_token", title="Webhook Secret Key", group=grp_webhook)
tradeQty = input.int(75, title="Trade Lot Quantity (Nifty: 75, Forex: 1000, Stock: 1)", group=grp_webhook)

// Webhook Alert Payloads (Sent directly to your Python Bot)
buyPayload = '{"secret":"' + webhookSecret + '","action":"BUY","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"quantity":' + str.tostring(tradeQty) + ',"sl":' + str.tostring(close - slDistance) + ',"target":' + str.tostring(close + tgtDistance) + ',"strategy":"SuperTrend_EMA_Regime"}'
sellPayload = '{"secret":"' + webhookSecret + '","action":"SELL","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"quantity":' + str.tostring(tradeQty) + ',"sl":' + str.tostring(close + slDistance) + ',"target":' + str.tostring(close - tgtDistance) + ',"strategy":"SuperTrend_EMA_Regime"}'
exitPayload = '{"secret":"' + webhookSecret + '","action":"SQUARE_OFF","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"strategy":"SuperTrend_EMA_Regime"}'

// Strategy Execution with Webhook Alerts
if (longCondition and strategy.position_size == 0)
    strategy.entry("BUY", strategy.long, qty=tradeQty, alert_message=buyPayload)
    strategy.exit("Long Exit", "BUY", loss=slDistance * tradeQty, profit=tgtDistance * tradeQty, alert_message=exitPayload)

if (shortCondition and strategy.position_size == 0)
    strategy.entry("SELL", strategy.short, qty=tradeQty, alert_message=sellPayload)
    strategy.exit("Short Exit", "SELL", loss=slDistance * tradeQty, profit=tgtDistance * tradeQty, alert_message=exitPayload)

// Standalone Alertconditions (for TradingView Indicator Alerts)
alertcondition(longCondition and strategy.position_size == 0, title="TradingOnline Long Alert", message="BUY Signal Triggered")
alertcondition(shortCondition and strategy.position_size == 0, title="TradingOnline Short Alert", message="SELL Signal Triggered")

// --- 9. ON-CHART REAL-TIME HUD DASHBOARD ---
var table hud = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 30), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "⚡ Trading Online", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "v2.0 Institutional", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 1, "SuperTrend (10,3)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, isBullishTrend ? "BULLISH" : "BEARISH", text_color=isBullishTrend ? color.green : color.red, text_size=size.small)
    
    table.cell(hud, 0, 2, "EMA (9 vs 21)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, emaFast > emaSlow ? "GOLDEN CROSS" : "DEATH CROSS", text_color=emaFast > emaSlow ? color.green : color.red, text_size=size.small)
    
    table.cell(hud, 0, 3, "RSI (14)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(rsiVal, "#.#"), text_color=color.yellow, text_size=size.small)
    
    table.cell(hud, 0, 4, "ADX / Choppiness", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(adxVal, "#.#") + " / " + str.tostring(ci, "#.#"), text_color=isRegimeTrending ? color.green : color.red, text_size=size.small)
    
    table.cell(hud, 0, 5, "Market Regime", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, isMiddayChop ? "MIDDAY CHOP" : (isRegimeTrending ? "TRENDING" : "SIDEWAYS CHOP"), text_color=isMiddayChop ? color.orange : (isRegimeTrending ? color.green : color.red), text_size=size.small)
